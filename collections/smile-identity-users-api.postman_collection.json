                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "user_id",
                      "description": "(Required) The partner-scoped user identifier of the enrolled user being\nreported. This is the `user_id` value originally provided during\nenrollment.\n"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "SmileID-Token",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
