                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) `true` to flag the user as fraudulent, `false` to clear a previous\nfraud flag.\n",
                        "type": "text/plain"
                      },
                      "key": "is_fraud",
