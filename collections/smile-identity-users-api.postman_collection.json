      },
      "item": [
        {
          "id": "f4f3942f-6023-49a3-b531-d2596a8a859d",
          "name": "Flag or clear fraud status for a user",
          "request": {
            "name": "Flag or clear fraud status for a user",
            "description": {
              "content": "Records a fraud report (or fraud-clearance) for a previously enrolled\nuser.\n\nUse `is_fraud: true` to flag a user as fraudulent, or `is_fraud: false`\nto clear a previous flag. Flagging propagates the user's face, device,\nand biometric clusters to the relevant block lists so that subsequent\nverifications matching them are rejected. Clearing the flag reverses\nthese effects.\n\nThe response is `202 Accepted` once the request has been validated\nand handled.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                ":user_id",
                "report_fraud"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "user_id",
                  "description": "(Required) The partner-scoped user identifier of the enrolled user being\nreported. This is the `user_id` value originally provided during\nenrollment.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "is_fraud",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "(Required) `true` to flag the user as fraudulent, `false` to clear a previous\nfraud flag.\n"
                },
                {
                  "key": "reported_by",
                  "value": "<email>",
                  "type": "text",
                  "description": "(Required) Email address of the person submitting the report."
                },
                {
                  "key": "reason",
                  "value": "<string>",
                  "type": "text",
                  "description": "Reason for the fraud report. **Required when `is_fraud` is `true`**;\nignored when `is_fraud` is `false`. If `OTHER` is selected, `notes`\nbecomes required.\n (This can only be one of FIRST_PARTY_FRAUD,SECOND_PARTY_FRAUD,THIRD_PARTY_FRAUD,SYNTHETIC_IDENTITY,ACCOUNT_TAKEOVER,DOCUMENT_FORGERY,IDENTITY_FARMING,MULE_ACCOUNT,OTHER)"
                },
                {
                  "key": "notes",
                  "value": "<string>",
                  "type": "text",
                  "description": "Free-form notes describing the fraud report. **Required when**\neither `is_fraud` is `false` or `reason` is `OTHER`. Optional in\nall other cases. Capped at 500 characters.\n"
                }
              ]
            }
          },
          "response": [
            {
              "id": "681297bb-7210-4fdb-9593-601fded31f37",
              "name": "Fraud report accepted and queued for processing.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v3",
                    "users",
                    ":user_id",
                    "report_fraud"
                  ],
                  "host": [
