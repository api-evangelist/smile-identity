                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required) Email address of the person submitting the report.",
                        "type": "text/plain"
                      },
                      "key": "reported_by",
                      "value": "<email>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "Reason for the fraud report. **Required when `is_fraud` is `true`**;\nignored when `is_fraud` is `false`. If `OTHER` is selected, `notes`\nbecomes required.\n (This can only be one of FIRST_PARTY_FRAUD,SECOND_PARTY_FRAUD,THIRD_PARTY_FRAUD,SYNTHETIC_IDENTITY,ACCOUNT_TAKEOVER,DOCUMENT_FORGERY,IDENTITY_FARMING,MULE_ACCOUNT,OTHER)",
                        "type": "text/plain"
                      },
                      "key": "reason",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "Free-form notes describing the fraud report. **Required when**\neither `is_fraud` is `false` or `reason` is `OTHER`. Optional in\nall other cases. Capped at 500 characters.\n",
                        "type": "text/plain"
