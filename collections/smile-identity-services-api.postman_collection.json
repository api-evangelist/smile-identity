        {
          "id": "c34f2594-d6ca-4de7-828e-d1fb050547af",
          "name": "Get ID type availability status",
          "request": {
            "name": "Get ID type availability status",
            "description": {
              "content": "Returns the current availability and success rate for a specific ID type\nin a given country, based on uptime data from the last hour.\n\nRequires authentication via JWT token.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "services",
                "id_status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "(Required) ISO 3166-1 alpha-2 country code or full country name (e.g. \"NG\" or \"Nigeria\")."
                },
                {
                  "disabled": false,
                  "key": "id_type",
                  "value": "<string>",
                  "description": "(Required) The ID type code to check status for (e.g. \"BVN\", \"NIN\", \"VOTER_ID\")."
                }
              ],
              "variable": []
