        {
          "id": "d390a903-4c4e-441c-9129-f7a6457db215",
          "name": "List supported documents for verification",
          "request": {
            "name": "List supported documents for verification",
            "description": {
              "content": "Returns a list of supported document types for identity verification across all\ncountries served by Smile Identity.\n\nThe response can be filtered by continent or country code. An optional `locale`\nparameter controls the language of document names.\n\nThis endpoint does not require authentication. It is an alias of\n`GET /v1/valid_documents` and `GET /v3/valid-documents`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "services",
                "supported_documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "continent",
                  "value": "<string>",
                  "description": "Filter results to a single continent."
                },
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "Filter results to a single country. Must be an ISO 3166-1 alpha-2 code\n(two uppercase letters).\n"
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en-GB",
                  "description": "Locale for document names. Defaults to `en-GB`.\nSupported values: `en-GB`, `fr-FR`, `ar-EG`.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
