{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smile ID V3 Authentication Biometric Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "SmileID-Token",
      "value": "{{SmileID-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Biometric Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit biometric authentication",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smileidentity.com/v3/authentication",
            "headers": [
              {
                "name": "SmileID-Source-SDK",
                "value": ""
              },
              {
                "name": "SmileID-Source-SDK-Version",
                "value": ""
              },
              {
                "name": "SmileID-Timestamp",
                "value": ""
              },
              {
                "name": "SmileID-Request-Signature",
                "value": ""
              },
              {
                "name": "User-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Authenticates a user by comparing a submitted selfie against their enrolled image. The selfie and liveness images are uploaded, validated at entry, then queued for async ML processing (passive liveness, active liveness, face matching). Results are delivered via callback URL.\nSupports `use_enrolled_image: true` to skip selfie/liveness upload and re-use the enrolled image for the comparison (useful for server-side re-verification)."
        }
      ]
    }
  ],
  "bundled": true
}