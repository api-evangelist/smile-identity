        {
          "id": "266e147b-f5ef-4631-b283-2b5aaceb376d",
          "name": "Replay a callback for a completed verification",
          "request": {
            "name": "Replay a callback for a completed verification",
            "description": {
              "content": "Looks up a previously completed verification by its TypeID, resolves the callback URL, and re-sends the callback. The verification must have reached a terminal state (clear, block, attention, or error) before its callback can be replayed.\nAn optional `callback_url` in the request body overrides the stored URL, subject to the partner's callback domain allowlist.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "replay",
                ":job_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "job_id",
                  "description": "(Required) TypeID format verification identifier with 'job_' prefix."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callback_url\": \"<uri>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
