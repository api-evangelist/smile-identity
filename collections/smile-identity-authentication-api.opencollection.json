{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smile ID V3 Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "SmileID-Token",
      "value": "{{SmileID-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate v3 Auth Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smileidentity.com/v3/token",
            "headers": [
              {
                "name": "smileid-partner-id",
                "value": ""
              },
              {
                "name": "smileid-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "user_id",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "partner_params",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "product",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Issues a short-lived JWT for authenticating subsequent v3 API requests."
        }
      ]
    }
  ],
  "bundled": true
}